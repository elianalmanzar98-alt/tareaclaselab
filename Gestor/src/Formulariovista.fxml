<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="FormulariovistaController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label style="-fx-font-weight: bold;" text="Datos del Producto" />
      <TextField fx:id="txtNombre" promptText="Nombre del producto" style="-fx-background-color: gray;" />
      <TextField fx:id="txtCategoria" promptText="Categoría" style="-fx-background-color: gray;" />
      <TextField fx:id="txtPrecio" promptText="Precio (Ej: 15.50)" style="-fx-background-color: gray;" />
      <TextField fx:id="txtCantidad" promptText="Cantidad (Ej: 10)" style="-fx-background-color: gray;" />
      <HBox alignment="CENTER" spacing="20.0">
         <children>
            <Button onAction="#guardar" prefWidth="100.0" style="-fx-background-color: yellow;" text="Guardar" />
            <Button onAction="#cerrar" prefWidth="100.0" style="-fx-background-color: yellow;" text="Cancelar" />
         </children>
      </HBox>
   </children>
</VBox>
